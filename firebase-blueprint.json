{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated platform user profile without plain-text credentials.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin", "faculty", "student"] },
        "department": { "type": "string", "maxLength": 32 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "isActive", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled university student record.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "department": { "type": "string", "maxLength": 32 },
        "semester": { "type": "integer" },
        "classId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["student"] },
        "faceEnrolled": { "type": "boolean" },
        "biometricConsent": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "name", "email", "department", "semester", "role", "isActive"]
    },
    "Faculty": {
      "title": "Faculty",
      "description": "Teaching faculty member record.",
      "type": "object",
      "properties": {
        "facultyId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "department": { "type": "string", "maxLength": 32 },
        "designation": { "type": "string", "maxLength": 80 },
        "assignedSubjectIds": { "type": "array" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["facultyId", "name", "email", "department", "isActive"]
    },
    "Department": {
      "title": "Department",
      "description": "Academic department.",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 16 },
        "name": { "type": "string", "maxLength": 120 },
        "headName": { "type": "string", "maxLength": 100 }
      },
      "required": ["departmentId", "code", "name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Course subject taught in a department and semester.",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 32 },
        "semester": { "type": "integer" },
        "facultyId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": ["subjectId", "code", "name", "department", "semester"]
    },
    "ClassroomClass": {
      "title": "ClassroomClass",
      "description": "Academic class section.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "department": { "type": "string", "maxLength": 32 },
        "semester": { "type": "integer" },
        "room": { "type": "string", "maxLength": 40 }
      },
      "required": ["classId", "name", "department", "semester"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "Faculty-initiated class attendance session.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "department": { "type": "string", "maxLength": 32 },
        "semester": { "type": "integer" },
        "subjectId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "facultyId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "durationMinutes": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "mode": { "type": "string", "enum": ["ai", "manual"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "department", "semester", "subjectId", "classId", "facultyId", "date", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual student attendance entry for a session.",
      "type": "object",
      "properties": {
        "attendanceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentOwnerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "maxLength": 100 },
        "subjectId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "facultyId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Present", "Absent", "Pending Review"] },
        "verificationMethod": { "type": "string", "enum": ["AI-assisted", "Manual"] },
        "confidence": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["attendanceId", "studentId", "studentName", "subjectId", "facultyId", "sessionId", "date", "status", "verificationMethod"]
    },
    "FaceTemplate": {
      "title": "FaceTemplate",
      "description": "Encrypted biometric template metadata isolated from public reads.",
      "type": "object",
      "properties": {
        "templateId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "encryptedDigest": { "type": "string", "maxLength": 512 },
        "consentGranted": { "type": "boolean" },
        "consentTimestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["templateId", "studentId", "ownerUid", "encryptedDigest", "consentGranted"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for attendance events and low attendance alerts.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetRole": { "type": "string", "enum": ["admin", "faculty", "student", "all"] },
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 400 },
        "category": { "type": "string", "enum": ["recorded", "completed", "correction", "warning", "report"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "recipientUid", "title", "message", "category", "isRead"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts keyed by Firebase UID."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student roster records."
    },
    "/faculty/{facultyId}": {
      "schema": { "$ref": "#/entities/Faculty" },
      "description": "Faculty member records."
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Academic departments."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Academic subjects."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassroomClass" },
      "description": "Class sections."
    },
    "/attendance_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/AttendanceSession" },
      "description": "Attendance sessions created by faculty."
    },
    "/attendance_records/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Individual attendance records preventing duplicates per session+student."
    },
    "/face_templates/{templateId}": {
      "schema": { "$ref": "#/entities/FaceTemplate" },
      "description": "Encrypted biometric templates restricted to owner or admin."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications."
    }
  }
}
