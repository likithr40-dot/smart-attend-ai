# GEMINI_API_KEY: Required for Gemini AI Vision face analysis & liveness checks.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the Smart Attend application.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used for signing JWT access tokens (set in production).
JWT_SECRET="smart-attend-dev-jwt-secret-change-in-prod"

# BIOMETRIC_ENCRYPTION_KEY: 32-byte key for AES-256-GCM encryption of biometric templates.
BIOMETRIC_ENCRYPTION_KEY="smart-attend-biometric-aes-256-key"
